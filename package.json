{
  "name": "nuxt-feature-flags-module",
  "version": "2026.9.0",
  "description": "Lightweight, environment-based feature flag system for Nuxt - made for developers who need dynamic feature control in routes, components, and APIs.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicokempe/nuxt-feature-flags-module.git"
  },
  "author": {
    "name": "Nico Kempe",
    "email": "kontakt@nicokempe.de",
    "url": "https://www.nicokempe.de"
  },
  "sideEffects": false,
  "license": "MIT",
  "type": "module",
  "keywords": [
    "nuxt",
    "nuxt3",
    "nuxt-module",
    "feature-flags",
    "feature-toggle",
    "feature-flag"
  ],
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "release:check": "tsc --project scripts/release/tsconfig.json && node --test scripts/release/version-policy.node.ts",
    "release:prepare": "node scripts/release/prepare-release.ts",
    "refresh": "rm -rf pnpm-lock.yaml .nuxt/ dist/ node_modules/ playground/.nuxt/ playground/.output/ playground/node_modules/ && pnpm install && nuxi prepare && pnpm run lint:fix && pnpm run test && pnpm run prepack && pnpm run dev"
  },
  "dependencies": {
    "@nuxt/kit": "4.5.2",
    "globby": "16.2.4",
    "pathe": "2.0.3"
  },
  "devDependencies": {
    "@nuxt/devtools": "3.4.2",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/eslint-config": "1.17.0",
    "@nuxt/module-builder": "1.0.3",
    "@nuxt/schema": "4.5.2",
    "@nuxt/test-utils": "4.3.2",
    "@types/node": "25.9.8",
    "changelogen": "^0.6.2",
    "eslint": "10.11.0",
    "nuxt": "4.5.2",
    "typescript": "5.9.3",
    "vitest": "5.0.1",
    "vue-tsc": "3.3.11",
    "wrangler": "4.136.1"
  },
  "packageManager": "pnpm@12.5.1"
}
